@api = http://localhost:8081

### Vagas: listar
GET {{api}}/vagas

### Vagas: buscar por id
GET {{api}}/vagas/1

### Vagas: id inexistente (404)
GET {{api}}/vagas/999

### Vagas: id que não é número (400)
GET {{api}}/vagas/abc

### Vagas: criar (201 + Location)
POST {{api}}/vagas
Content-Type: application/json

{
  "titulo": "Pessoa Desenvolvedora Java Pleno",
  "descricao": "Serviços de cobrança em Spring Boot, com fila e observabilidade.",
  "area": "Back-end",
  "senioridade": "Pleno",
  "local": "Remoto",
  "aceitaIniciante": false,
  "empresaSlug": "tucano-systems"
}

### Vagas: criar com campos faltando (400)
POST {{api}}/vagas
Content-Type: application/json

{}

### Vagas: criar com empresa inexistente (422)
POST {{api}}/vagas
Content-Type: application/json

{
  "titulo": "Pessoa Desenvolvedora Java Pleno",
  "area": "Back-end",
  "senioridade": "Pleno",
  "empresaSlug": "nao-existe"
}

### Vagas: atualizar
PUT {{api}}/vagas/1
Content-Type: application/json

{
  "titulo": "Pessoa Desenvolvedora Front-end Pleno",
  "descricao": "Telas do produto em React e Next.js.",
  "area": "Front-end",
  "senioridade": "Pleno",
  "local": "Remoto",
  "aceitaIniciante": false,
  "empresaSlug": "aurora-tech"
}

### Vagas: apagar (204, e 404 na segunda vez)
DELETE {{api}}/vagas/12

### Vagas: busca por área e senioridade
GET {{api}}/vagas/busca?area=Dados&senioridade=Júnior

### Vagas: busca por quem aceita iniciante
GET {{api}}/vagas/busca?aceitaIniciante=true

### Vagas: busca sem resultado (200 com lista vazia)
GET {{api}}/vagas/busca?area=Jogos

### Estatísticas
GET {{api}}/estatisticas

### Empresas: listar
GET {{api}}/empresas

### Empresas: buscar por slug
GET {{api}}/empresas/aurora-tech

### Empresas: slug inexistente (404)
GET {{api}}/empresas/nao-existe

### Empresas: criar (201 + Location)
POST {{api}}/empresas
Content-Type: application/json

{
  "nome": "Farol Tech",
  "slug": "farol-tech",
  "site": "farol.tech",
  "descricao": "Software para portos e terminais."
}

### Empresas: slug repetido (409)
POST {{api}}/empresas
Content-Type: application/json

{
  "nome": "Outra Aurora",
  "slug": "aurora-tech"
}

### Empresas: slug fora do formato (400)
POST {{api}}/empresas
Content-Type: application/json

{
  "nome": "Farol Tech",
  "slug": "Farol Tech"
}

### Empresas: atualizar
PUT {{api}}/empresas/farol-tech
Content-Type: application/json

{
  "nome": "Farol Tecnologia",
  "slug": "farol-tech",
  "site": "farol.tech",
  "descricao": "Software para portos, terminais e armazéns."
}

### Empresas: apagar empresa sem vagas (204)
DELETE {{api}}/empresas/farol-tech

### Empresas: apagar empresa com vagas (409)
DELETE {{api}}/empresas/aurora-tech

### Pessoas: listar
GET {{api}}/pessoas

### Pessoas: buscar por id
GET {{api}}/pessoas/1

### Pessoas: id inexistente (404)
GET {{api}}/pessoas/999

### Pessoas: criar (201 + Location)
POST {{api}}/pessoas
Content-Type: application/json

{
  "nome": "Helena Costa",
  "email": "helena@exemplo.com",
  "area": "Back-end",
  "senioridade": "Júnior"
}

### Pessoas: e-mail repetido (409)
POST {{api}}/pessoas
Content-Type: application/json

{
  "nome": "Ana Repetida",
  "email": "ana@exemplo.com",
  "area": "Dados",
  "senioridade": "Júnior"
}

### Pessoas: e-mail inválido (400)
POST {{api}}/pessoas
Content-Type: application/json

{
  "nome": "Sem Email",
  "email": "nao-e-email",
  "area": "Dados",
  "senioridade": "Júnior"
}

### Pessoas: atualizar
PUT {{api}}/pessoas/1
Content-Type: application/json

{
  "nome": "Ana Nogueira",
  "email": "ana@exemplo.com",
  "area": "Dados",
  "senioridade": "Pleno"
}

### Pessoas: apagar (204, e 404 na segunda vez)
DELETE {{api}}/pessoas/6
